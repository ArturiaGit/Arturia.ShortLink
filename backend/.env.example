MYSQL_PORT=3307
MYSQL_DATABASE=arturia_shortlink
MYSQL_USER=arturia
MYSQL_PASSWORD=<请填写本地开发密码>
MYSQL_ROOT_PASSWORD=<请填写本地Root密码>

# 启动 API 前设置为与上面一致的连接串；仓库不保存真实密码。
ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3307;Database=arturia_shortlink;User=arturia;Password=<请填写本地开发密码>
Database__AutoMigrate=true
Database__SeedDemoData=true

# JWT 签名密钥至少 32 字节；生产环境必须由 Secret Manager 注入。
Jwt__SecretKey=<请填写至少32字节的随机密钥>
Jwt__Issuer=Arturia.ShortLink
Jwt__Audience=Arturia.ShortLink
Jwt__ExpirationDays=7
